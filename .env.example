# Django
SECRET_KEY=change-me-in-production
DEBUG=True
IS_PRODUCTION=False
CSRF_TRUSTED_ORIGINS=https://giftme.co.ke,https://www.giftme.co.ke
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,giftme.co.ke,www.giftme.co.ke

# Django admin (created/updated on every Railway deploy)
# Login at /admin/ using DJANGO_SUPERUSER_EMAIL as the username (unless USERNAME is set).
# Avoid $ in the password — Railway may treat it as variable substitution.
DJANGO_SUPERUSER_EMAIL=admin@giftme.co.ke
DJANGO_SUPERUSER_PASSWORD=change-me-strong-password
# Optional override; defaults to the email above
# DJANGO_SUPERUSER_USERNAME=admin@giftme.co.ke
SITE_DOMAIN=giftme.co.ke
SITE_NAME=GiftMe

# Database (Postgres when IS_PRODUCTION=True; SQLite otherwise)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/giftme

# Email (required for verification, password reset, withdrawal OTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_smtp_username
EMAIL_HOST_PASSWORD=your_smtp_password
DEFAULT_FROM_EMAIL=GiftMe <info@giftme.co.ke>

# Redis (optional — use Memurai/Redis locally for rate limits & OAuth cache)
REDIS_URL=redis://127.0.0.1:6379/1

# M-Pesa Daraja (sandbox: https://developer.safaricom.co.ke)
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback/
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# M-Pesa B2C (withdrawals)
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_COMMAND_ID=BusinessPayment
MPESA_B2C_RESULT_URL=
MPESA_B2C_TIMEOUT_URL=

# Payment throttling
STK_QUERY_MIN_AGE_SECONDS=25
STK_IP_LIMIT=10
STK_IP_WINDOW=60
STK_PHONE_LIMIT=5
STK_PHONE_WINDOW=3600
STK_MAX_PENDING_PER_PHONE_PROFILE=3
STK_PROFILE_LIMIT=100
STK_PROFILE_WINDOW=3600
PAYMENT_PENDING_EXPIRY_MINUTES=15
WITHDRAWAL_OTP_EXPIRY_MINUTES=10

# Platform fee (applied on each gift; set in env, not ops dashboard)
PLATFORM_FEE_PERCENT=10
PLATFORM_FEE_CAP=800
