# Django
SECRET_KEY=generate-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,giftme.co

# Railway injects DATABASE_URL when you attach Postgres.
# DATABASE_URL=

# Optional — Railway also sets RAILWAY_PUBLIC_DOMAIN automatically.
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# Redis (optional — use Memurai/Redis locally for rate limits & OAuth cache)
REDIS_URL=redis://127.0.0.1:6379/1

# M-Pesa Daraja — set MPESA_CALLBACK_URL to your Railway HTTPS domain
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-app.up.railway.app/api/mpesa/callback/
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# M-Pesa B2C withdrawals
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_COMMAND_ID=BusinessPayment

# Payment throttling
STK_QUERY_MIN_AGE_SECONDS=25
STK_IP_LIMIT=10
STK_IP_WINDOW=60
STK_PHONE_LIMIT=5
STK_PHONE_WINDOW=3600
STK_MAX_PENDING_PER_PHONE_PROFILE=3
STK_PROFILE_LIMIT=100
STK_PROFILE_WINDOW=3600
PAYMENT_PENDING_EXPIRY_MINUTES=15

# Platform fee (applied on each gift)
PLATFORM_FEE_PERCENT=10
PLATFORM_FEE_CAP=800

# Email (withdrawal verification codes)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GiftMe <hello@giftme.app>
WITHDRAWAL_OTP_EXPIRY_MINUTES=10
