# Django (required on Railway)
SECRET_KEY=generate-a-long-random-secret
DEBUG=False

# Railway injects DATABASE_URL when you attach Postgres.
# DATABASE_URL=

# Optional — Railway also sets RAILWAY_PUBLIC_DOMAIN automatically.
# ALLOWED_HOSTS=your-app.up.railway.app,.railway.app
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# M-Pesa Daraja — set MPESA_CALLBACK_URL to your Railway HTTPS domain
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-app.up.railway.app/api/mpesa/callback/
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# M-Pesa B2C withdrawals
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_COMMAND_ID=BusinessPayment

# Email (withdrawal verification codes)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GiftMe <hello@giftme.app>
